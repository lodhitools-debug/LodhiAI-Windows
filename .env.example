# ==============================================================================
# LODHI AI — COMMERCIAL SAAS & CLOUD RELAY PRODUCTION ENVIRONMENT TEMPLATE
# ==============================================================================
# WARNING: Do NOT place real production secrets or private keys in this file.
# Copy this file to .env.production and provide real secrets via your secure secret
# manager (e.g. AWS Secrets Manager, Google Secret Manager, Doppler, or Vault).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER & NETWORK CONFIGURATION
# ------------------------------------------------------------------------------
NODE_ENV=production
HOST=0.0.0.0
PORT=4000
PUBLIC_RELAY_URL=wss://relay.lodhiai.com

# ------------------------------------------------------------------------------
# 2. CRYPTOGRAPHIC SECRETS & AUTHENTICATION
# ------------------------------------------------------------------------------
# Must be a cryptographically secure random string of at least 32 bytes (256 bits)
LODHI_JWT_SECRET=replace-with-a-strong-random-32-byte-hex-string-for-jwt-signing
JWT_EXPIRY_SECONDS=900
REFRESH_TOKEN_EXPIRY_SECONDS=604800

# ------------------------------------------------------------------------------
# 3. FIREBASE-FIRST CLOUD PLATFORM CONFIGURATION (PRIMARY CLOUD BACKEND)
# ------------------------------------------------------------------------------
# Client Web / Desktop configuration (public identifiers; safe for client bundle)
VITE_FIREBASE_API_KEY=AIzaSy_replace_with_client_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=replace_with_fcm_sender_id
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# Firebase Emulator Settings (for local dev & security test runner)
VITE_USE_FIREBASE_EMULATOR=false
VITE_FIREBASE_EMULATOR_HOST=127.0.0.1
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# Firebase Admin SDK (Backend / Cloud Run / Privileged Service ONLY - NEVER bundle into client)
FIREBASE_PROJECT_ID=your-project-id
GOOGLE_APPLICATION_CREDENTIALS=/etc/secrets/firebase-service-account.json

# ------------------------------------------------------------------------------
# 4. DATABASE CONFIGURATION (POSTGRESQL - RETAINED FOR ENTERPRISE SELF-HOSTING)
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://lodhi_app_user:replace_with_db_password@postgres-prod.internal:5432/lodhi_commercial_db?sslmode=require
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=20

# ------------------------------------------------------------------------------
# 5. PAYMENT & SUBSCRIPTION GATEWAYS (WEBHOOK SIGNATURE VERIFICATION)
# ------------------------------------------------------------------------------
# Stripe Configuration (Test Mode prefix: whsec_test_ / Prod prefix: whsec_)
STRIPE_WEBHOOK_SECRET=whsec_replace_with_stripe_webhook_signing_secret
STRIPE_API_KEY=sk_test_replace_with_stripe_secret_key

# Lemon Squeezy Configuration
LEMON_SQUEEZY_WEBHOOK_SECRET=replace_with_lemonsqueezy_webhook_secret_key
LEMON_SQUEEZY_API_KEY=replace_with_lemonsqueezy_api_key

# ------------------------------------------------------------------------------
# 6. COMMERCIAL LICENSING & ENTITLEMENTS
# ------------------------------------------------------------------------------
# Ed25519 / HMAC Public Verification Key for offline desktop license tickets
LODHI_LICENSE_VERIFY_KEY=lodhi-commercial-public-license-verification-key-ed25519
LODHI_LICENSE_ISSUER=LodhiAI-Commercial-Licensing-Authority

# ------------------------------------------------------------------------------
# 7. RATE LIMITING & ABUSE DEFENSE
# ------------------------------------------------------------------------------
AUTH_RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX_ATTEMPTS=5
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX_REQUESTS=120
RELAY_MSG_RATE_LIMIT_PER_MINUTE=60

# ------------------------------------------------------------------------------
# 8. LOGGING & OBSERVABILITY
# ------------------------------------------------------------------------------
LOG_LEVEL=info
ENABLE_ANONYMOUS_METRICS=true
SENTRY_DSN=
