<?xml version="1.0" encoding="utf-8"?>
<!--
    Lodhi AI Companion Network Security Config
    Permits cleartext HTTP for private local network communication with the PC companion server.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
